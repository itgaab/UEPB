# Copie para .streamlit/secrets.toml (uso local) ou cole em
# "Advanced settings > Secrets" no Streamlit Community Cloud.
# NUNCA suba o secrets.toml real para o GitHub.

# --- Opção recomendada: VANDER IA com Claude (chave criada em console.anthropic.com) ---
ANTHROPIC_API_KEY = "sk-ant-cole-sua-chave-aqui"
# ANTHROPIC_MODEL = "claude-haiku-5-5"   # opcional (padrão: Haiku, o mais barato)

# --- Alternativa: endpoint próprio do VANDER IA (formato "chat/completions" da OpenAI) ---
# VANDER_API_URL = "https://SEU-ENDERECO/v1/chat/completions"
# VANDER_API_KEY = "sua-chave"
# VANDER_MODEL   = "nome-do-modelo"

# --- Alternativa gratuita: Gemini (a IA responde como VANDER IA) ---
# GEMINI_API_KEY = "sua-chave"
# GEMINI_MODEL = "gemini-2.5-flash"
